{
  "manifest_version": 3,
  "name": "itsflow para Chrome",
  "description": "Demonstre tarefas com o assistente e execute automações conectadas ao itsflow Studio.",
  "version": "0.2.101",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "tabCapture",
    "offscreen",
    "downloads",
    "notifications",
    "alarms",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:18453/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir itsflow",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "input-lock.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-outline.js",
        "automation-cursor.js",
        "content.js",
        "demonstration-capture-content.js",
        "demonstration-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "demonstration.html"
  }
}
